# PARAKH OCR / semantic mapping
# PaddleOCR remains the OCR/detection layer.
OCR_AI_PROVIDER=gemini
OCR_AI_API_KEY=
OCR_AI_MODEL=gemini-3.5-flash-lite

# Gemini semantic assist runs in parallel with PaddleOCR for field interpretation and category suggestion.
# GEMINI_API_KEY can also be used; the backend accepts either key name.
GEMINI_API_KEY=
GEMINI_SEMANTIC_MODEL=gemini-3.5-flash-lite

# OCR runtime
OCR_TIMEOUT_MS=30000
OCR_CONFIDENCE_THRESHOLD=0.6
OCR_MAX_IMAGE_SIZE_BYTES=8388608
OCR_MAX_IMAGES_PER_REQUEST=6
