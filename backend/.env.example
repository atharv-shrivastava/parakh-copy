# PARAKH OCR / semantic mapping
# RapidOCR is the local OCR/detection layer.
OCR_AI_PROVIDER=consensus
OCR_AI_API_KEY=
OCR_AI_MODEL=

# Gemini semantic vision model
GEMINI_API_KEY=
GEMINI_SEMANTIC_MODEL=gemini-3.7-flash

# Cloudflare Workers AI semantic vision models
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Used by the secondary Cloudflare semantic provider when no override is supplied.
CLOUDFLARE_SEMANTIC_MODEL=@cf/meta/llama-3.2-11b-vision-instruct

# RapidOCR runtime
RAPID_OCR_URL=http://localhost:8081
RAPIDOCR_LANG_TYPE=en
RAPIDOCR_MAX_SIDE=1024
RAPIDOCR_USE_CLS=false
RAPIDOCR_TEXT_SCORE=0.5
OCR_TIMEOUT_MS=30000
OCR_CONFIDENCE_THRESHOLD=0.6
OCR_MAX_IMAGE_SIZE_BYTES=8388608
OCR_MAX_IMAGES_PER_REQUEST=6
