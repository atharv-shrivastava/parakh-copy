generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  passwordHash   String?
  role           String        @default("USER")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  sessions       Session[]
  scans          Scan[]
  inspections   Inspection[]
  categories     Category[]
  products       Product[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Shop {
  id          String        @id @default(cuid())
  name        String
  address     String?
  city        String?
  state       String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  inspections Inspection[]

  @@index([name])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String
  isFinal   Boolean    @default(false)
  isGlobal  Boolean    @default(false)
  ownerId   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
  owner     User?      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([parentId, slug])
  @@index([ownerId])
  @@index([isGlobal])
  @@index([parentId])
}

model Product {
  id               String        @id @default(cuid())
  brandName        String?
  productName      String
  description      String?
  ocrData          String?
  netQuantity      String?
  unit              String?
  mrp              Float?
  barcode          String?
  imageUrl         String?
  imageUrls        String?
  complianceStatus String        @default("NEEDS_REVIEW")
  violationReason  String?
  ownerId          String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  owner            User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  inspections      Inspection[]

  @@index([categoryId])
  @@index([ownerId])
  @@index([brandName])
  @@index([productName])
  @@index([barcode])
  @@index([complianceStatus])
  @@index([createdAt])
}

model Scan {
  id          String      @id @default(cuid())
  imageUrl    String?
  ocrText     String?
  status      String      @default("PENDING")
  createdAt   DateTime    @default(now())
  workerId    String
  worker      User        @relation(fields: [workerId], references: [id], onDelete: Restrict)
  inspection  Inspection?
}

model Inspection {
  id          String    @id @default(cuid())
  status      String    @default("NEEDS_REVIEW")
  notes       String?
  inspectedAt DateTime  @default(now())
  workerId    String
  shopId      String
  productId   String
  scanId      String?   @unique
  worker      User      @relation(fields: [workerId], references: [id], onDelete: Restrict)
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  scan        Scan?     @relation(fields: [scanId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([productId])
  @@index([workerId])
  @@index([inspectedAt])
}
