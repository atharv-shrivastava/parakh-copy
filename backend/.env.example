# PARAKH OCR / semantic mapping
OCR_AI_PROVIDER=gemini
OCR_AI_API_KEY=
OCR_AI_MODEL=gemini-2.5-flash

# Semantic mapper. Gemini is primary; OpenAI is automatic fallback.
OCR_SEMANTIC_PROVIDER=gemini
OCR_SEMANTIC_TIMEOUT_MS=10000

# OpenAI semantic fallback
OPENAI_API_KEY=
OPENAI_SEMANTIC_MODEL=gpt-5-mini

# Google Cloud Vision OCR. Keep this key server-side only.
GOOGLE_CLOUD_VISION_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=

OCR_VISION_TIMEOUT_MS=10000
OCR_TIMEOUT_MS=30000
OCR_CONFIDENCE_THRESHOLD=0.6
OCR_MAX_IMAGE_SIZE_BYTES=8388608
OCR_MAX_IMAGES_PER_REQUEST=6
